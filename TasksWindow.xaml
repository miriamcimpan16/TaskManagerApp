<Window x:Class="TaskManagerApp.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Tasks" Height="600" Width="600"
        WindowStartupLocation="CenterScreen">
        <Window.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/background.jpg" Stretch="UniformToFill"/>
        </Grid.Background>
        
        <!-- Titlul proiectului sus (va fi pus din C# în funcție de pe care ai dat click) -->
<TextBox x:Name="ProjectTitleTextBox" 
           Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
           FontFamily="pack://application:,,,/TaskManagerApp;component/GreatVibes-Regular.ttf#Great Vibes"
           FontSize="45"
           Foreground="#1B4D3E"
           Background="Transparent" 
           BorderBrush="Transparent"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="35,15,0,0"
           IsReadOnly="True"
           IsHitTestVisible="True"
           MouseDoubleClick="ProjectTitle_MouseDoubleClick"
           KeyDown="ProjectTitle_KeyDown"
           LostFocus="ProjectTitle_LostFocus"/>

        <!-- Subtitlul "tasks for this project" -->
        <TextBlock Text="tasks for this project"
                   FontSize="18" Foreground="#1B4D3E"
                   FontFamily="pack://application:,,,/TaskManagerApp;component/DellaRespira-Regular.ttf#Della Respira"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="45,85,0,0"/>

        <!-- Mesajul "No tasks yet?" când lista e goală -->
        <TextBlock x:Name="NoTasksText" Text="No tasks yet?" 
                   FontSize="22" Foreground="#7A7A7A" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="pack://application:,,,/TaskManagerApp;component/DellaRespira-Regular.ttf#Della Respira" FontStyle="Italic"
                   Visibility="Visible"/>

        <!-- Lista de task-uri -->
        <ListBox x:Name="TasksListBox" 
                 Background="Transparent" BorderBrush="Transparent"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="40,125,40,40" Width="500" Height="395"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
           <ListBox.ItemTemplate>
    <DataTemplate>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
            <!-- Chenarul bej al task-ului -->
            <Border Background="#E6DCD0" CornerRadius="20" Width="420" Height="50">
                <Grid>
                    <!-- Cercul bifei -->
                    <Border Width="34" Height="34" HorizontalAlignment="Left" Margin="10,0,0,0"
                            Background="#D8CEBE" CornerRadius="17" BorderBrush="White" BorderThickness="2"
                            Cursor="Hand" MouseLeftButtonUp="ToggleTask_Click">
                        <TextBlock Text="✓" Foreground="#1B4D3E" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                    </Border>

                    <!-- Textul task-ului -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="55,0,20,0">
                        <TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="pack://application:,,,/TaskManagerApp;component/DellaRespira-Regular.ttf#Della Respira"
                                 FontSize="18" Foreground="#1B4D3E"
                                 Background="Transparent" BorderBrush="Transparent"
                                 VerticalContentAlignment="Center" IsReadOnly="True" IsHitTestVisible="True"
                                 MouseDoubleClick="TextBox_MouseDoubleClick" KeyDown="TextBox_KeyDown" LostFocus="TextBox_LostFocus"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Butonul de ștergere (✕) pus direct lângă chenar -->
            <Button Width="35" Height="35" Margin="10,0,0,0" VerticalAlignment="Center"
                    Background="Transparent" BorderBrush="Transparent" Cursor="Hand"
                    Click="DeleteTask_Click">
                <TextBlock Text="✕" Foreground="#7A7A7A" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </DataTemplate>
</ListBox.ItemTemplate>
        </ListBox>

        <!-- Butonul verde cu plus (+) pentru task-uri -->
        <Button Width="80" Height="80" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,40,40"
                Background="#1B4D3E" 
                BorderBrush="Transparent"
                Cursor="Hand"
                Click="AddTask_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="25">
                        <Grid Margin="15,0">
                            <TextBlock Text="✚" Foreground="#FFFFDEAD" FontSize="30" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- Butonul rotund de Back cu săgeată -->
<Button Width="45" Height="45" 
         HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Margin="40,0,0,40"
        Background="Transparent" 
        BorderBrush="Transparent"
        Cursor="Hand"
        Click="BackToProjects_Click">
    <Button.Template>
        <ControlTemplate TargetType="Button">
            <!-- Cerculețul exterior cu contur fin gri/alb -->
            <Border Background="Transparent" 
                    BorderBrush="#D0C7B8" 
                    BorderThickness="1.5" 
                    CornerRadius="22.5">
                <!-- Săgeata verde din interior -->
                <TextBlock Text="↩" 
                           Foreground="#1B4D3E" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Margin="0,-2,2,0"/>
            </Border>
        </ControlTemplate>
    </Button.Template>
</Button>

    </Grid>

</Window>