<Window x:Class="TaskManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager App"
        Height="600" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#f5f0ea">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/background.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2.15*"/>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="1.35*"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0"
                   Source="pack://application:,,,/TaskManagerApp;component/girl.png"
                   Width="160"
                   Height="200"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,38,0,0"
                   Stretch="Uniform"/>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,0,0,0">
                <TextBlock Text="Welcome to"
                           FontFamily="pack://application:,,,/TaskManagerApp;component/DellaRespira-Regular.ttf#Della Respira"
                           FontSize="22"
                           Foreground="Green"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,3"/>

                <TextBlock Text="Task Manager App"
                           FontFamily="pack://application:,,,/TaskManagerApp;component/GreatVibes-Regular.ttf#Great Vibes"
                           FontSize="42"
                           Foreground="#1B4D3E"
                           HorizontalAlignment="Center"
                           TextOptions.TextFormattingMode="Display"/>
            </StackPanel>

            <Button Grid.Row="2"
                    Width="120"
                    Height="52"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,40"
                    Background="#1B4D3E"
                    BorderBrush="Transparent"
                    Cursor="Hand"
                    Click="Button_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="26">
                            <Grid Margin="18,0,16,0">
                                <TextBlock Text="➤"
                                           Foreground="#F7E7B6"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>