<Window x:Class="TaskManagerApp.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Your Projects" Height="600" Width="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/background.jpg" Stretch="UniformToFill" />
        </Grid.Background>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,30,0,0">
            <TextBlock Text="Your projects"
                       FontFamily="pack://application:,,,/TaskManagerApp;component/GreatVibes-Regular.ttf#Great Vibes"
                       FontSize="50"
                       Foreground="#1B4D3E"
                       HorizontalAlignment="Left" />
        </StackPanel>

        <TextBlock x:Name="NoIdeasText" Text="No ideas?˳༄꠶"
                   FontSize="30" Foreground="#1B4D3E"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="pack://application:,,,/TaskManagerApp;component/DellaRespira-Regular.ttf#Della Respira"
                   Visibility="Visible" />

        <ListBox x:Name="ProjectsListBox"
                 Background="Transparent" BorderBrush="Transparent"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="40,110,40,40" Width="500" Height="410"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <!-- Chenarul bej al proiectului -->
                        <Border Background="#E6DCD0" CornerRadius="20" Width="420" Height="50" Cursor="Hand" MouseLeftButtonUp="ProjectCard_Click">
                            <Grid>
                                <!-- Cercul din stânga pentru bifarea proiectului -->
                                <Border Width="34" Height="34" HorizontalAlignment="Left" Margin="10,0,0,0"
                                        Background="#D8CEBE" CornerRadius="17" BorderBrush="White" BorderThickness="2"
                                        Cursor="Hand" MouseLeftButtonUp="ToggleProject_Click">
                                    <TextBlock Text="✓" Foreground="#1B4D3E" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                </Border>

                                <!-- TextBox pentru numele proiectului (cu dublu-click pentru editare) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="55,0,20,0">
                                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="pack://application:,,,/TaskManagerApp;component/DellaRespira-Regular.ttf#Della Respira"
                                             FontSize="18" Foreground="#1B4D3E"
                                             Background="Transparent" BorderBrush="Transparent"
                                             VerticalContentAlignment="Center" IsReadOnly="True" IsHitTestVisible="True"
                                             MouseDoubleClick="TextBox_MouseDoubleClick" KeyDown="TextBox_KeyDown" LostFocus="TextBox_LostFocus" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Butonul de ștergere (✕) plasat imediat în dreapta chenarului -->
                        <Button Width="35" Height="35" Margin="10,0,0,0" VerticalAlignment="Center"
                                Background="Transparent" BorderBrush="Transparent" Cursor="Hand"
                                Click="DeleteProject_Click">
                            <TextBlock Text="✕" Foreground="#7A7A7A" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Butonul verde din dreapta jos (cu săgeată) -->
        <Button Width="80" Height="80"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,40,40"
                Background="#1B4D3E"
                BorderBrush="Transparent"
                Cursor="Hand" Click="AddProject_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="25">
                        <Grid Margin="15,0">
                            <TextBlock Text="✚" Foreground="#FFFFDEAD" FontSize="30" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Butonul rotund de Back spre MainWindow -->
        <Button Width="45" Height="45"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="40,0,0,40"
                Background="Transparent"
                BorderBrush="Transparent"
                Cursor="Hand"
                Click="BackToMain_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"
                            BorderBrush="#D0C7B8"
                            BorderThickness="1.5"
                            CornerRadius="22.5">
                        <TextBlock Text="↩"
                                   Foreground="#1B4D3E"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-2,2,0" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>